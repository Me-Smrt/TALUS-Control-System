    (at 6.0 -2.4 0)
    (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)) (justify left))
  )

  ; Mechanical-reference labels for connector-access planning.
  (fp_text user "USB / ETHERNET EDGE"
    (at 72.5 23.2 90)
    (layer "F.SilkS")
