  ; Official nominal mounting-hole centers: 58mm x 49mm spacing, 3.5mm from left/top edges.
  ; Hole diameter 2.7mm, suitable for M2.5 hardware.
  (pad "" np_thru_hole circle
    (at -4.87 -1.27)
    (size 2.7 2.7)
    (drill 2.7)
    (layers "*.Cu" "*.Mask")
  )
  (pad "" np_thru_hole circle
    (at 53.13 -1.27)
    (size 2.7 2.7)
    (drill 2.7)
    (layers "*.Cu" "*.Mask")
  )
  (pad "" np_thru_hole circle
    (at -4.87 47.73)
    (size 2.7 2.7)
    (drill 2.7)
    (layers "*.Cu" "*.Mask")
  )
  (pad "" np_thru_hole circle
    (at 53.13 47.73)
    (size 2.7 2.7)
    (drill 2.7)
    (layers "*.Cu" "*.Mask")
  )

  ; Official Raspberry Pi 5 STEP model (with graphics).
  ; STEP uses a conventional Y-up coordinate system; the footprint uses KiCad Y-down.
  ; Official board geometry places GPIO pin 1 at X=8.37 mm from the left edge and
  ; 4.77 mm from the top edge (Y=51.23 mm from the lower edge in STEP coordinates).
  (model "${KIPRJMOD}/rpi-5b_with_graphics.step"
    (offset (xyz -8.37 -51.23 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)
