(footprint "Raspberry_Pi_5_Mechanical"
  (version 20240108)
  (generator "pcbnew")
  (generator_version "8.0")
  (layer "F.Cu")
  (descr "Raspberry Pi 5 mechanical reference. Origin is GPIO header Pin 1 center. Based on official Raspberry Pi 5 mechanical drawing and 40-pin HAT geometry. Includes four 2.7mm NPTH M2.5 mounting holes and an attached official Raspberry Pi 5 STEP model reference. Place/flip on the CCB side facing the Pi.")
  (tags "Raspberry Pi 5 RPi5 mechanical 85x56 M2.5 GPIO")
  (property "Reference" "REF**"
    (at 34.13 23.23 0)
    (layer "F.SilkS")
    (effects (font (size 1.2 1.2) (thickness 0.18)))
  )
  (property "Value" "Raspberry_Pi_5_Mechanical"
    (at 34.13 25.23 0)
    (layer "F.Fab")
    (hide yes)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (property "Footprint" ""
    (at 0 0 0)
    (layer "F.Fab")
    (hide yes)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (property "Datasheet" "https://datasheets.raspberrypi.com/rpi5/raspberry-pi-5-mechanical-drawing.pdf"
    (at 0 0 0)
    (layer "F.Fab")
    (hide yes)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (property "Description" "Mechanical-only Raspberry Pi 5 reference; 85x56mm nominal board, 58x49mm mounting-hole spacing, 2.7mm mounting holes."
    (at 0 0 0)
    (layer "F.Fab")
    (hide yes)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (attr through_hole board_only exclude_from_pos_files exclude_from_bom)

  ; Nominal Pi PCB outline, origin = GPIO pin 1 center.
  ; Board edges relative to pin 1: X -8.37..76.63, Y -4.77..51.23.
  (fp_rect
    (start -8.37 -4.77)
    (end 76.63 51.23)
    (stroke (width 0.25) (type default))
    (fill none)
    (layer "F.SilkS")
  )
  (fp_rect
    (start -8.37 -4.77)
    (end 76.63 51.23)
    (stroke (width 0.12) (type default))
    (fill none)
    (layer "F.Fab")
  )

  ; Full Pi body reference envelope. User.1 is intentionally used instead of a courtyard
  ; so the required GPIO socket does not create a permanent courtyard-overlap DRC error.
  (fp_rect
    (start -8.87 -5.27)
    (end 77.13 51.73)
    (stroke (width 0.15) (type dash))
    (fill none)
    (layer "User.1")
  )
  (fp_text user "PI-FACING-SIDE COMPONENT KEEPOUT REFERENCE"
    (at 34.13 31.0 0)
    (layer "User.1")
    (effects (font (size 0.9 0.9) (thickness 0.14)))
  )

  ; GPIO header mechanical reference (2x20, 2.54mm pitch).
  ; Physical Pi pin 1 is the footprint origin. Odd pins run +X; even pins are
  ; 2.54 mm toward the nearby board edge (-Y in this top-view reference).
  (fp_rect
    (start -1.27 -3.81)
    (end 49.53 1.27)
    (stroke (width 0.15) (type default))
    (fill none)
    (layer "F.Fab")
  )

