# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build output
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test / coverage / tooling caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pyright/
.ruff_cache/

# ------------------------------------------------------------
# Flask / application runtime
# ------------------------------------------------------------
instance/
*.sqlite
*.sqlite3
*.db

# Local secrets / environment files
.env
.env.*
!.env.example

# Generated Flask session / cache data
flask_session/
.cache/

# ------------------------------------------------------------
# Logs / runtime files
# ------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.pid

# ------------------------------------------------------------
# IDE / editor
# ------------------------------------------------------------
.vscode/
.idea/
*.code-workspace

# ------------------------------------------------------------
# Operating system
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# Front-end / browser tooling (future-proofing)
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------
# Local certificates / keys
# Never commit private cryptographic material.
# ------------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
certs/
secrets/

# ------------------------------------------------------------
# Project-specific generated / local-only files
# ------------------------------------------------------------
uploads/
backups/
