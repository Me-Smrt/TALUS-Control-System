# REQUIRED outside ARC_DEV_MODE.
ARC_SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated hostnames/IPs accepted by Flask 3.1+ host validation.
# Example for a fixed local deployment:
# ARC_TRUSTED_HOSTS=robot.local,192.168.50.20

# Optional. For a single-process local deployment, memory:// is acceptable.
# For multiple workers later, use a shared limiter backend such as Redis.
ARC_RATE_LIMIT_STORAGE=memory://

# Optional database location. Default: ./instance/auth.sqlite3
# ARC_AUTH_DB=/secure/path/auth.sqlite3

# Development only. Disables Secure cookies and enables Flask debug mode.
# NEVER use this for the deployed robot dashboard.
ARC_DEV_MODE=0

ARC_PORT=5000

# Raspberry Pi perception/control-state API. The dashboard proxies this server-side
# so a bearer token is never exposed to browser JavaScript.
ARC_ROBOT_API_BASE=http://127.0.0.1:8766
# Set this to the same value as AUTOMATON_API_TOKEN if the Pi API requires auth.
ARC_ROBOT_API_TOKEN=
ARC_ROBOT_API_TIMEOUT_S=1.5

# Auxiliary cognition service (server-side dashboard proxy).
# Windows R&D: 127.0.0.1 is correct when dashboard + Aux run on the same PC.
# Final Pi-hosted dashboard: replace this with the auxiliary computer's LAN IP.
ARC_AUX_API_BASE=http://127.0.0.1:8770
ARC_AUX_API_TOKEN=
ARC_AUX_API_TIMEOUT_S=8.0
