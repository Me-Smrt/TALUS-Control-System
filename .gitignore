# TALUS public, source-first monorepo. Track human-readable code, KiCad design
# sources, tests, docs, scripts, manifests, and reproducible config templates.
# Never commit secrets, local user data, model weights or generated CAD assets.

# Credentials / local machine state
**/.env
**/.env.*
!**/.env.example
!**/.env.template
**/secrets/
**/certs/
**/*credentials*.json
**/*secret*.json
**/config/local.json
**/config/*.local.json
*.pem
*.key
*.p12
*.pfx
*.token

# Python / editor / test caches
**/.venv/
**/venv/
**/env/
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.coverage*
**/htmlcov/
**/.idea/
**/.vscode/
**/.history/
**/.cache/
**/.tox/
**/.nox/
**/.ipynb_checkpoints/
**/.vs/
**/node_modules/
**/build/
**/dist/
**/*.egg-info/
.DS_Store
Thumbs.db

# Runtime, private or generated application data
Software/**/models/
Software/**/runtime/
Software/**/logs/
Software/**/_archive/
Software/Dashboard/instance/
Software/**/flask_session/
**/uploads/
**/captures/
**/recordings/
**/screenshots/
**/tmp/
**/temp/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.log
*.jsonl
*.wav
*.flac
*.mp3
*.ogg
*.pid
*.mp4
*.avi
*.mov
*.mkv
*.webm

# Downloaded LLM/STT/TTS/CV weights and executable artifacts, anywhere
*.gguf
*.safetensors
*.onnx
*.pth
*.pt
*.ckpt
*.h5
*.tflite
*.bin
*.exe
*.dll
*.pyd
*.so
*.dylib

# Blender output, input geometry, cache and backups (scripts remain tracked)
*.blend
*.blend[0-9]*
*.blend@
*.3mf
*.stl
*.obj
*.fbx
*.glb
*.gltf
*.step
*.stp
*.iges
*.igs
*.wrl
*.dae
*.ply
Model/_inmoov_cache/
Model/InMoov_Complete_Rigged_MM.json

# KiCad source is tracked: .kicad_pro/.kicad_pcb/.kicad_sch,
# .kicad_sym/.kicad_mod, .pretty libraries, fp-lib-table, sym-lib-table.
*.kicad_prl
*.bak
*-backups/
*-autosave.kicad_*
*.kicad_sch-bak
*.kicad_pcb-bak

# KiCad fabrication exports can be regenerated from the committed PCB sources.
Design/**/Manufacturing/
*.gbr
*.gbrjob
*.drl

# Bundled downloads, generated manufacturing packages and archives
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
Design/Misc/Archive/
**/tools_backup/
**/.git/
